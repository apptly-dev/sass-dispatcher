{
  "name": "@apptly/sass-dispatcher-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apptly SaaS dispatcher admin CLI",
  "author": "Apptly Software Ltd <oss@apptly.co>",
  "license": "UNLICENSED",
  "bin": {
    "sass-dispatcher": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "clean": "rimraf dist node_modules coverage",
    "dev:prepare": "obuild --stub",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "prepack": "run-s lint:check type-check build test",
    "prepare": "cross-test -s dist/bin.mjs || obuild --stub",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "run-s type-check:main type-check:tools type-check:tests",
    "type-check:main": "tsc --noEmit -p tsconfig.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:tools": "tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "@apptly/sass-dispatcher": "workspace:^",
    "citty": "^0.2.2",
    "cloudflare": "^6.1.0",
    "confbox": "^0.2.4",
    "consola": "^3.4.2",
    "xdg-app-paths": "^8.3.0"
  },
  "devDependencies": {
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "~0.9.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "eslint": "^9.39.4",
    "npm-run-all2": "^8.0.4",
    "obuild": "^0.4.34",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
